-- ============================================================================
-- DIRECT DECOMPILED GUN OVERRIDE SYSTEM
-- ============================================================================
local function overrideGunTable(config)
    -- Fire Rate & Damage Mods
    config.Auto = true
    config.FireRate = 0
    config.BaseDamage = 999999
    config.HeadshotEnabled = true
    config.HeadshotDamageMultiplier = 100
    config.CriticDamage = true
    config.CriticBaseChance = 100
    
    -- Recoil & Spread
    config.Spread = 0
    config.SpreadRedution = 0
    config.CameraShakingEnabled = false
    config.Knockback = 0
    
    -- Infinite Ammo & Fast Firing
    config.LimitedClipEnabled = false
    config.AmmoPerClip = 999999
    config.MaxClip = 999999
    config.Clips = 999999
    config.ReloadTime = 0
    config.ShotDelay = 0
    config.DelayBeforeFiring = 0
    config.DelayAfterFiring = 0
    
    -- Multishot / Shotgun Mods
    config.BulletPerShot = 15
    config.BulletSpeed = 5000
    config.Piercing = 99
end

local function modifyTaurusGun()
    -- 1. Modify the template in ReplicatedStorage directly
    local repTools = ReplicatedStorage:FindFirstChild("Tools")
    if repTools then
        local repGun = repTools:FindFirstChild(GUN_NAME)
        if repGun then
            local settingScript = repGun:FindFirstChild("GunScript_Local") and repGun.GunScript_Local:FindFirstChild("Setting")
            if settingScript then
                local success, config = pcall(require, settingScript)
                if success and type(config) == "table" then
                    overrideGunTable(config)
                    print("[NoobHub] Modified ReplicatedStorage template for " .. GUN_NAME)
                end
            end
        end
    end

    -- 2. Modify Backpack & Character Instances
    local function processTool(tool)
        local settingScript = tool:FindFirstChild("Setting", true) or tool:FindFirstChild("Settings", true)
        if settingScript and settingScript:IsA("ModuleScript") then
            local success, config = pcall(require, settingScript)
            if success and type(config) == "table" then
                overrideGunTable(config)
                print("[NoobHub] Modified active weapon: " .. tool.Name)
            end
        end
    end

    for _, item in ipairs(localPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") then processTool(item) end
    end
    if localPlayer.Character then
        for _, item in ipairs(localPlayer.Character:GetChildren()) do
            if item:IsA("Tool") then processTool(item) end
        end
    end
end

-- ============================================================================
-- TOOL RENAMER
-- ============================================================================
local function renameTools(newName)
    local backpack = localPlayer:FindFirstChildOfClass("Backpack")
    local character = localPlayer.Character

    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then tool.Name = newName end
        end
    end
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") then tool.Name = newName end
        end
    end
end

local backpackRef = localPlayer:WaitForChild("Backpack")
backpackRef.ChildAdded:Connect(function(child)
    if child:IsA("Tool") then
        if customToolName ~= "" then child.Name = customToolName end
        modifyTaurusGun()
    end
end)

