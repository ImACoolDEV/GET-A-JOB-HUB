-- ============================================================================
-- WORKING GUN MODIFIER (Forces Script Restart to Apply Settings)
-- ============================================================================
local function applyGunModsToTable(config)
    config.Auto = true
    config.FireRate = 0
    config.BaseDamage = 999999
    config.HeadshotEnabled = true
    config.HeadshotDamageMultiplier = 100
    config.CriticDamage = true
    config.CriticBaseChance = 100
    config.Spread = 0
    config.SpreadRedution = 0
    config.CameraShakingEnabled = false
    config.LimitedClipEnabled = false
    config.AmmoPerClip = 999999
    config.MaxClip = 999999
    config.Clips = 999999
    config.ReloadTime = 0
    config.ShotDelay = 0
    config.DelayBeforeFiring = 0
    config.DelayAfterFiring = 0
    config.BulletPerShot = 10
    config.BulletSpeed = 2000
    config.Piercing = 100
end

local function modifyTool(tool)
    -- Find Setting Module (Supports direct parent or nested under GunScript_Local)
    local settingModule = tool:FindFirstChild("Setting", true)
    if not settingModule then
        local repTools = ReplicatedStorage:FindFirstChild("Tools")
        if repTools and repTools:FindFirstChild(tool.Name) then
            settingModule = repTools[tool.Name]:FindFirstChild("Setting", true)
        end
    end

    if settingModule and settingModule:IsA("ModuleScript") then
        local success, config = pcall(require, settingModule)
        if success and type(config) == "table" then
            applyGunModsToTable(config)
            print("[NoobHub] Modified Setting Table for: " .. tool.Name)
            
            -- Restart local gun script to force it to re-read the setting module
            local localGunScript = tool:FindFirstChild("GunScript_Local", true)
            if localGunScript and localGunScript:IsA("LocalScript") then
                localGunScript.Disabled = true
                task.wait(0.05)
                localGunScript.Disabled = false
                print("[NoobHub] Restarted GunScript_Local for: " .. tool.Name)
            end
        end
    end
end

local function scanAndModifyGuns()
    -- Scan Backpack
    for _, item in ipairs(localPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            modifyTool(item)
        end
    end
    -- Scan Character
    if localPlayer.Character then
        for _, item in ipairs(localPlayer.Character:GetChildren()) do
            if item:IsA("Tool") then
                modifyTool(item)
            end
        end
    end
end

-- Tool Renamer
local function renameTools(newName)
    local backpack = localPlayer:FindFirstChildOfClass("Backpack")
    local character = localPlayer.Character

    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then tool.Name = newName end
        end
    end
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") then tool.Name = newName end
        end
    end
end

-- Auto-mod on tool added
local backpackRef = localPlayer:WaitForChild("Backpack")
backpackRef.ChildAdded:Connect(function(child)
    if child:IsA("Tool") then
        if customToolName ~= "" then child.Name = customToolName end
        task.wait(0.1)
        modifyTool(child)
    end
end)

